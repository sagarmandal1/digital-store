{
  "manifest_version": 3,
  "name": "Digital Store – CRM for WhatsApp",
  "version": "2.8.1",
  "description": "Professional CRM assistant for WhatsApp Web. Manage customers, sales, collections, and admin workflows directly from chat.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Toggle Digital Store CRM Panel"
    }
  },
  "host_permissions": [
    "https://digital-store.top/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Digital Store CRM"
  },
  "background": {
    "service_worker": "background.js"
  }
}